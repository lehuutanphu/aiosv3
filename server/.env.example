# Sao chép file này thành ".env" rồi điền giá trị thật — KHÔNG commit ".env" vào git.

# Cổng chạy Proxy này (AI OS Dashboard sẽ gọi vào cổng này)
PROXY_PORT=8787

# Các origin được phép gọi Proxy, phân cách bằng dấu phẩy (đúng domain/port đang chạy website AI OS).
# Proxy này luôn chạy trên máy của người mở dashboard — kể cả khi họ mở bản đã deploy (Cloudflare
# Workers/Pages) thay vì dashboard chạy local — nên cần liệt kê đủ mọi origin có thể gọi tới, không
# chỉ 1 origin duy nhất. Sai/thiếu origin sẽ bị trình duyệt CHẶN Ở TẦNG CORS dù request vẫn "thành
# công" ở tầng mạng — dễ nhầm tưởng proxy không chạy.
ALLOWED_ORIGIN=http://localhost:64667,http://localhost:5173,https://workers.ai-os.vn

# true = trả lời giả lập, không cần Hermes/Mem0 thật đang chạy (dùng để test Proxy độc lập)
# false = gọi thật tới Hermes API Server + Mem0 theo agents.config.json
MOCK_MODE=true

# API_SERVER_KEY của từng Hermes Profile — đặt tên biến theo agentId viết hoa, "-" -> "_"
# vd agentId "sales-1" -> HERMES_KEY_SALES_1
HERMES_KEY_SALES_1=
HERMES_KEY_SALES_2=
HERMES_KEY_MKT_1=
HERMES_KEY_MKT_2=
HERMES_KEY_MKT_3=
HERMES_KEY_MKT_4=
HERMES_KEY_MKT_5=
HERMES_KEY_HR_1=
HERMES_KEY_FIN_1=
HERMES_KEY_FIN_2=
HERMES_KEY_LEGAL_1=
HERMES_KEY_CSKH_1=
HERMES_KEY_CSKH_2=

# Mem0 API key dùng chung cho toàn bộ Profile (phân vùng theo agent_id ở tầng Hermes/Mem0)
MEM0_API_KEY=

# DeepSeek V4 Flash qua OpenRouter — thực thi B2-B10 skill Tuyển dụng (project/aios/hr) tại local,
# KHÔNG qua Hermes. Lấy tại https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
# Model dùng để thực thi — đổi theo slug thật trên openrouter.ai/models nếu khác
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
# Trần chờ một lượt gọi OpenRouter (ms). Quá hạn thì lượt đó thất bại rõ ràng thay vì treo
# cả vòng lặp Content Cluster. Tier free hay xếp hàng lâu — nâng số này nếu chấp nhận chờ.
OPENROUTER_TIMEOUT_MS=180000
# Model riêng cho lượt đọc CV (B4, có đính kèm PDF) — cần model có vision để đọc PDF gốc trực tiếp,
# tránh lỗi "chỉ đọc được metadata" khi CV là bản scan/đồ họa không có lớp text. Kiểm tra slug thật
# trên openrouter.ai/models trước khi đổi.
OPENROUTER_CV_MODEL=anthropic/claude-haiku-4.5

# --- Module Thu thập Lead (sales-2) ---
# Cookie phiên Facebook, chỉ dùng khi cần đọc bài/nhóm mà tài khoản của bạn xem được.
# CÂN NHẮC: tự động hóa truy cập bằng cookie tài khoản là vi phạm Điều khoản của Meta.
# Bỏ trống là lựa chọn mặc định — khi nguồn bị chặn, hãy dán nội dung bình luận tay.
FB_COOKIE=
